# Rehearsal needs no credentials. Live inference is explicitly opt-in.
CLASHPOINT_AWS_ENABLED=false
CLASHPOINT_ACCESS_CODE=
STRANDS_DECIDER_URL=http://127.0.0.1:8099
DECIDER_MIN_CONFIDENCE=0.65
INFERENCE_TIMEOUT_MS=30000
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Existing local profile; omit when an AWS instance role supplies credentials.
AWS_PROFILE=

# Legacy optional adapters. Live GitHub does not feed fixture verification.
GITHUB_ENABLED=false
GITHUB_REPOSITORY=
GITHUB_TOKEN=
GEMINI_ENABLED=false
GEMINI_AUTH_KEY=
GEMINI_MODEL=
