{
  "name": "clashpoint-aws",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --incremental false",
    "eval:router": "node --env-file-if-exists=.env.local scripts/evaluate-router.mjs",
    "smoke:aws": "node --env-file-if-exists=.env.local scripts/smoke-aws.mjs",
    "test:e2e": "pnpm build && playwright test",
    "demo:preflight": "pnpm test && pnpm build",
    "demo:browser-check": "pnpm build && playwright test accessibility.spec.ts demo-controls.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1154.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@11.19.0"
}
